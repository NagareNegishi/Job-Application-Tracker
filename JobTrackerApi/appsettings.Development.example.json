{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "JobTrackerContext": "<your-postgres-connection-string>"
  },

  "Storage": {
    "UploadsPath": "<path-to-uploads-folder>"
  },

  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },

  "Jwt": {
    "Key": "<min-32-char-secret>",
    "Issuer": "JobTrackerApi",
    "Audience": "JobTrackerClient",
    "ExpiryMinutes": 15,
    "RefreshExpiryDays": 7
  },

  "App": {
    "FrontendBaseUrl": "http://127.0.0.1:5173"
  },

  "Admin": {
    "Email": "<your-admin-email>"
  },

  "Anthropic": {
    "ApiKey": "<your-anthropic-api-key>"
  }

}
