# Job Tracker — EC2 production environment variables
# Copy this file to .env on the EC2 instance and fill in real values.
# This file is safe to commit — it contains no secrets.

# PostgreSQL connection string (RDS)
DB_CONNECTION_STRING=Host=YOUR_RDS_ENDPOINT;Port=5432;Database=jobtracker;Username=postgres;Password=YOUR_DB_PASSWORD

# JWT — all three must match exactly between token generation and validation
JWT_SECRET=your-long-random-secret-minimum-32-characters
JWT_ISSUER=https://yourdomain.com
JWT_AUDIENCE=https://yourdomain.com

# S3 bucket name (without s3:// prefix)
S3_BUCKET_NAME=your-bucket-name

# ECR registry URI (format: {account-id}.dkr.ecr.ap-southeast-2.amazonaws.com)
ECR_REGISTRY=your-account-id.dkr.ecr.ap-southeast-2.amazonaws.com

# Demo reset key — secret for POST /api/auth/demo/reset (called by nightly cron)
DEMO_RESET_KEY=your-long-random-reset-key


